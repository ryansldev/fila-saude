NODE_ENV=test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fila_central
POSTGRES_PORT=5433
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB

TENANT_DATABASE_URL_TEMPLATE=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/{banco}
TENANT_BASE_DOMAIN=localhost
TENANT_MODE=multi
CENTRAL_URL=http://localhost:3333
MAILER=banco
TENANT_CACHE_TTL_MS=0
AUTH_JWT_TTL=15m
PAINEL_ORIGEM_TEMPLATE=http://{slug}.localhost:3000

BETTER_AUTH_SECRET=test-only-secret-do-not-use-in-production
